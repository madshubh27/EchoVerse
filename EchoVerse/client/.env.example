# ================================================
# EchoVerse Client — Environment Variables
# ================================================
# Copy this file to .env.local and fill in values.
# Only VITE_* variables are exposed to the browser.
# API keys must be set in Vercel Dashboard, NOT here.

# --- API Base URL ---
# Defaults to /api (same-origin Vercel serverless routes).
# Override for local development against the Python backend:
#   VITE_TOKEN_PROXY_URL=http://localhost:8000
VITE_TOKEN_PROXY_URL=/api
