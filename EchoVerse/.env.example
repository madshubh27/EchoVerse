# ============================================
# Vocal Bridge Voice Agent — Environment Config
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# --- LiveKit Cloud ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- Vocal Bridge API ---
VOCAL_BRIDGE_API_URL=http://localhost:8001
VOCAL_BRIDGE_API_KEY=your_secret_api_key_here

# --- AI Providers ---
OPENAI_API_KEY=sk-your-openai-key
DEEPGRAM_API_KEY=your_deepgram_key
ELEVENLABS_API_KEY=your_elevenlabs_key

# --- External Systems ---
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_DOMAIN=yourcompany
JIRA_PROJECT_KEY=OPS
EMAIL_FROM=alerts@yourcompany.com
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your_email@gmail.com
EMAIL_SMTP_PASSWORD=your_app_password
STATUSPAGE_API_KEY=your_statuspage_key
STATUSPAGE_PAGE_ID=your_page_id

# --- Database ---
DATABASE_URL=postgresql://vocalbridge:vocalbridge@localhost:5432/vocalbridge

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
